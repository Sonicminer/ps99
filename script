local player = game.Players.LocalPlayer
local workspace = game:GetService("Workspace")
local plots = workspace.__THINGS.Plots

for _, plot in pairs(plots:GetChildren()) do
    local success, err = pcall(function()
        local textLabel = plot.Interactable.OwnerSign.SurfaceGui.Frame.TextLabel
        if textLabel.Text == player.DisplayName .. "'s Farm" then
            getgenv().plotID = tonumber(plot.Name)
            print("Dein Plot wurde gefunden: " .. getgenv().plotID)
        end
    end)
end

if getgenv().plotID == nil then
    warn("Kein Plot gefunden.")
end

